{
  "manifest_version": 2,
  "name": "VideoGrab — загрузка видео",
  "short_name": "VideoGrab",
  "version": "1.0.2",
  "description": "Кнопка загрузки видео поверх плеера: приоритет источника выбранного видео, прямые файлы, незашифрованный HLS и базовый DASH.",
  "permissions": [
    "downloads",
    "storage",
    "webRequest",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "VideoGrab — нажмите, чтобы включить/выключить",
    "default_icon": {
      "16": "icons/on16.png",
      "32": "icons/on32.png"
    }
  },
  "icons": {
    "16": "icons/on16.png",
    "48": "icons/on48.png",
    "128": "icons/on128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
